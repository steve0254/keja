# Copy this file to .env for local development, and set the same keys in
# your Cloudflare Pages / Workers project settings for production.

# --- Supabase (existing) ---------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key: server-only, never exposed to the client. Used by
# src/integrations/supabase/client.server.ts and the AI assistant's tools.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Assistant -----------------------------------------------------------
# Which provider to use: "openai" | "anthropic" | "gemini".
# Optional — if unset, the first provider below with an API key is used.
AI_PROVIDER=anthropic

# Set only the key(s) for the provider(s) you intend to use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash

# Max assistant requests per client (signed-in user id, or IP) per minute.
AI_RATE_LIMIT_PER_MINUTE=12
